# PHPStan at the highest level, as the family's harness runs it (docker compose run --rm omnibank
# phpstan, in omnisense/omnibank's docker/). phpstan-baseline.neon holds what was there when
# PHPStan came in (2026-11-10): it may only shrink.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
    # The bundle names every provider's factory (OmnibankBundle::FACTORIES) and registers those installed,
    # and its test lists those installed.
    # Installed alone (this package's CI), they are unknown classes; with every provider (the family's
    # harness), PHPStan knows them. Both hold.
    ignoreErrors:
        -
            identifier: class.notFound
            paths:
                - Bridge/Symfony/OmnibankBundle.php
                - Tests/Bridge/OmnibankBundleTest.php
            reportUnmatched: false
        -
            identifier: function.alreadyNarrowedType
            path: Bridge/Symfony/OmnibankBundle.php
            reportUnmatched: false
