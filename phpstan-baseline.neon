			count: 1
			path: Bridge/Symfony/OmnibankBundle.php

		-
			message: '#^Method Omnibank\\Gateway\:\:connect\(\) should return Omnibank\\Model\\ConnectResult but returns Omnibank\\Model\\ConnectResult\|null\.$#'
