parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_subclass_of\(\) with ''Omnibank\\\\Bridge\\\\BridgeGatewayFactory''\|''Omnibank\\\\Files\\\\FilesGatewayFactory''\|''Omnibank\\\\Powens\\\\PowensGatewayFactory''\|''Omnibank\\\\Qonto\\\\QontoGatewayFactory'' and ''Omnibank\\\\GatewayFactoryInterface'' will always evaluate to true\.$#'
