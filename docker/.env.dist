# Your providers' sandbox keys: copy to .env (git-ignored), fill in what you have.
# A provider is configured once every key its README calls for is set; the
# others stay listed as "not configured" by `docker compose run --rm omnibank gateways`.

# Where the providers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIBANK_PLUGINS=../..
# Where omnisense/contracts' checkout is (../../../omnisense-contracts beside the family's folder); unset, GitHub.
#OMNISENSE_CONTRACTS=../../../omnisense-contracts

# Where a provider's page sends the user back (any URL will do to read the result by hand).
HARNESS_RETURN_URL=https://example.org/bank/back

# Statement files (no keys: always configured; the debtor for transfer files)
FILES_DEBTOR_NAME="Nakaya SAS"
FILES_DEBTOR_BIC=
# Qonto (Settings > Integrations > API key: the login and the secret key; the sandbox's staging token from the developer portal)
QONTO_LOGIN=
QONTO_SECRET_KEY=
QONTO_SANDBOX=0
QONTO_STAGING_TOKEN=
# Powens (console.powens.com: the domain, a client application's id and secret, its webhook secret)
POWENS_DOMAIN=
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_WEBHOOK_SECRET=
POWENS_WEBHOOK_URL=
POWENS_LANGUAGE=fr
# Bridge (dashboard.bridgeapi.io: a sandbox application's client id and secret, its webhook secret)
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
BRIDGE_VERSION=2025-01-15
BRIDGE_WEBHOOK_SECRET=
BRIDGE_USER_EMAIL=
